Mplus VERSION 8.11
MUTHEN & MUTHEN
04/29/2026  12:15 PM

INPUT INSTRUCTIONS

  TITLE: Multilevel Bayesian Analysis - SPED on RSESN Categories;
         (Reference: White Female Resources)

  DATA:
    FILE IS merged_2024.dat;

  VARIABLE:
    NAMES ARE is_sped school reg_n rs_n;
    USEVARIABLES ARE is_sped school
    rs_aaf0 rs_aaf1 rs_aam0 rs_aam1 rs_aif0 rs_aif1 rs_aim0 rs_aim1
    rs_asf0 rs_asf1 rs_asm0 rs_asm1 rs_hwf0 rs_hwf1 rs_hwm0 rs_hwm1
    rs_hlf0 rs_hlf1 rs_hlm0 rs_hlm1 rs_mrf0 rs_mrf1 rs_mrm0 rs_mrm1
    rs_naf  rs_nam  rs_wf1  rs_wm0  rs_wm1;



    CATEGORICAL is_sped;
    MISSING ARE .; !tells MPLUS the dots are all NAs

  DEFINE:
    ! Reference Group: White_Female_0 (Code 27) - Excluded from definitions

    ! African American Groups
    rs_aaf0  = (rs_n == 1);   ! African American Female Non-SES
    rs_aaf1  = (rs_n == 2);   ! African American Female Low-Income
    rs_aam0  = (rs_n == 3);   ! African American Male Non-SES
    rs_aam1  = (rs_n == 4);   ! African American Male Low-Income

    ! American Indian Groups
    rs_aif0  = (rs_n == 5);   ! American Indian Female Non-SES
    rs_aif1  = (rs_n == 6);   ! American Indian Female Low-Income
    rs_aim0  = (rs_n == 7);   ! American Indian Male Non-SES
    rs_aim1  = (rs_n == 8);   ! American Indian Male Low-Income

    ! Asian Groups
    rs_asf0  = (rs_n == 9);   ! Asian Female Non-SES
    rs_asf1  = (rs_n == 10);  ! Asian Female Low-Income
    rs_asm0  = (rs_n == 11);  ! Asian Male Non-SES
    rs_asm1  = (rs_n == 12);  ! Asian Male Low-Income

    ! Hawaiian/Pacific Islander Groups
    rs_hwf0  = (rs_n == 13);  ! Hawaiian Female Non-SES
    rs_hwf1  = (rs_n == 14);  ! Hawaiian Female Low-Income
    rs_hwm0  = (rs_n == 15);  ! Hawaiian Male Non-SES
    rs_hwm1  = (rs_n == 16);  ! Hawaiian Male Low-Income

    ! Hispanic/Latino Groups
    rs_hlf0  = (rs_n == 17);  ! Hispanic/Latino Female Non-SES
    rs_hlf1  = (rs_n == 18);  ! Hispanic/Latino Female Low-Income
    rs_hlm0  = (rs_n == 19);  ! Hispanic/Latino Male Non-SES
    rs_hlm1  = (rs_n == 20);  ! Hispanic/Latino Male Low-Income

    ! Multi-Racial Groups
    rs_mrf0  = (rs_n == 21);  ! Multi-Racial Female Non-SES
    rs_mrf1  = (rs_n == 22);  ! Multi-Racial Female Low-Income
    rs_mrm0  = (rs_n == 23);  ! Multi-Racial Male Non-SES
    rs_mrm1  = (rs_n == 24);  ! Multi-Racial Male Low-Income

    ! Administrative Lag / Missing Groups
    rs_naf   = (rs_n == 25);  ! NA Female
    rs_nam   = (rs_n == 26);  ! NA Male

    ! White Comparison Groups
    rs_wf1   = (rs_n == 28);  ! White Female Low-Income
    rs_wm0   = (rs_n == 29);  ! White Male Non-SES
    rs_wm1   = (rs_n == 30);  ! White Male Low-Income

  ANALYSIS:
    ESTIMATOR = BAYES;
    PROCESSORS = 4;
    BITERATIONS = (5000);
    BCONVERGENCE = 0.01;

  MODEL:
  ! Model now strictly tests group differences against white females
    is_sped ON rs_aaf0 rs_aaf1 rs_aam0 rs_aam1 rs_aif0 rs_aif1 rs_aim0 rs_aim1
               rs_asf0 rs_asf1 rs_asm0 rs_asm1 rs_hwf0 rs_hwf1 rs_hwm0 rs_hwm1
               rs_hlf0 rs_hlf1 rs_hlm0 rs_hlm1 rs_mrf0 rs_mrf1 rs_mrm0 rs_mrm1
               rs_naf  rs_nam  rs_wf1  rs_wm0  rs_wm1;


  OUTPUT:
    TECH1 TECH8 STDYX;



*** WARNING in MODEL command
  Variable is uncorrelated with all other variables:  SCHOOL
*** WARNING in MODEL command
  At least one variable is uncorrelated with all other variables in the model.
  Check that this is what is intended.
   2 WARNING(S) FOUND IN THE INPUT INSTRUCTIONS



