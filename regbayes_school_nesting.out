INPUT INSTRUCTIONS

  TITLE: Two-Level Multilevel Bayesian Analysis (Students in Schools);

  DATA:
    FILE IS "S:\Ibrahim\UConn Spencer Project Analysis Delaware Data\K-12_24.txt";

  VARIABLE:
      NAMES ARE Schl is_sped reg_num regses_num;

      ! Category 13 (White_F) is removed from here to make it the reference
      USEVARIABLES ARE Schl is_sped
        reg_aa_f reg_aa_m reg_ai_f reg_ai_m
        reg_as_f reg_as_m reg_hw_f reg_hw_m
        reg_hl_f reg_hl_m reg_mr_f reg_mr_m
        reg_w_m;

      CATEGORICAL IS is_sped;
      CLUSTER IS Schl;      ! Defines the nesting (Level 2)
      MISSING ARE ALL (-999); !tells MPLUS the empty cells are all NAs
      WITHIN = reg_aa_f reg_aa_m reg_ai_f reg_ai_m
        reg_as_f reg_as_m reg_hw_f reg_hw_m
        reg_hl_f reg_hl_m reg_mr_f reg_mr_m
        reg_w_m;

  DEFINE:
        ! Reference Group: White_Female (Excluded from definitions)

        reg_aa_f = (reg_num == 1);   ! African American Female
        reg_aa_m  = (reg_num == 2);   ! African American Male
        reg_ai_f = (reg_num == 3);   ! American Indian Female
        reg_ai_m = (reg_num == 4);   ! American Indian Male
        reg_as_f = (reg_num == 5);   ! Asian Female
        reg_as_m = (reg_num == 6);   ! Asian Male
        reg_hw_f = (reg_num == 7);   ! Hawaiian Female
        reg_hw_m = (reg_num == 8);   ! Hawaiian Male
        reg_hl_f = (reg_num == 9);  ! Hispanic/Latino Female
        reg_hl_m = (reg_num == 10);  ! Hispanic/Latino Male
        reg_mr_f = (reg_num == 11);  ! Multi-Racial Female
        reg_mr_m = (reg_num == 12);  ! Multi-Racial Male
        reg_w_m = (reg_num == 16);  ! White Male


        ANALYSIS:
      TYPE = TWOLEVEL;      ! Enables Multilevel modeling
      ESTIMATOR = BAYES;
      PROCESSORS = 4;
      BITERATIONS = (5000);
      BCONVERGENCE = 0.05;

    MODEL:
      %WITHIN%              ! Level 1 (Student Level)
      is_sped ON reg_aa_f reg_aa_m reg_ai_f reg_ai_m
        reg_as_f reg_as_m reg_hw_f reg_hw_m
        reg_hl_f reg_hl_m reg_mr_f reg_mr_m
        reg_w_m;

      %BETWEEN%             ! Level 2 (School Level)
      is_sped;                 ! Estimates the random intercept (school-level variance)

    OUTPUT:
      TECH1 TECH8 STANDARDIZED;



