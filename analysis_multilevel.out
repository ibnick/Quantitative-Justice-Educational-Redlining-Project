INPUT INSTRUCTIONS


  TITLE: Two-Level Multilevel Bayesian Analysis (Students in Schools);

  DATA:
    FILE IS merged_2024.dat;

  VARIABLE:
    NAMES ARE is_sped school reg_n rs_n;
    USEVARIABLES ARE is_sped school
      reg_mr_f reg_w_m reg_aa_m reg_hl_m reg_hl_f
      reg_aa_f reg_ai_f reg_as_m reg_hw_f reg_as_f
      reg_mr_m reg_ai_m reg_hw_m reg_na_f reg_na_m;

    CATEGORICAL IS is_sped;
    CLUSTER IS school;      ! Defines the nesting (Level 2)
    MISSING ARE .;
    WITHIN = reg_mr_f reg_w_m reg_aa_m reg_hl_m reg_hl_f
      reg_aa_f reg_ai_f reg_as_m reg_hw_f reg_as_f
      reg_mr_m reg_ai_m reg_hw_m reg_na_f reg_na_m;

  DEFINE:
    ! Reference Group: White_Female (Excluded from definitions)

    reg_mr_f = (reg_n == 1);   ! Multi-Racial Female
    reg_w_m  = (reg_n == 2);   ! White Male
    reg_aa_m = (reg_n == 3);   ! African American Male
    reg_hl_m = (reg_n == 4);   ! Hispanic/Latino Male
    reg_hl_f = (reg_n == 5);   ! Hispanic/Latino Female
    reg_aa_f = (reg_n == 7);   ! African American Female
    reg_ai_f = (reg_n == 8);   ! American Indian Female
    reg_as_m = (reg_n == 9);   ! Asian Male
    reg_hw_f = (reg_n == 10);  ! Hawaiian Female
    reg_as_f = (reg_n == 11);  ! Asian Female
    reg_mr_m = (reg_n == 12);  ! Multi-Racial Male
    reg_ai_m = (reg_n == 13);  ! American Indian Male
    reg_hw_m = (reg_n == 14);  ! Hawaiian Male
    reg_na_f = (reg_n == 15);  ! NA Female (Administrative Lag Group)
    reg_na_m = (reg_n == 16);  ! NA Male (Administrative Lag Group)


  ANALYSIS:
    TYPE = TWOLEVEL;      ! Enables Multilevel modeling
    ESTIMATOR = BAYES;
    PROCESSORS = 4;
    BITERATIONS = (5000);
    BCONVERGENCE = 0.05;

  MODEL:
    %WITHIN%              ! Level 1 (Student Level)
    is_sped ON reg_mr_f reg_w_m reg_aa_m reg_hl_m reg_hl_f
      reg_aa_f reg_ai_f reg_as_m reg_hw_f reg_as_f
      reg_mr_m reg_ai_m reg_hw_m reg_na_f reg_na_m;

    %BETWEEN%             ! Level 2 (School Level)
    is_sped;                 ! Estimates the random intercept (school-level variance)

  OUTPUT:
    TECH1 TECH8 STDYX;




