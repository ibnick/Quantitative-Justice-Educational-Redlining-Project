INPUT INSTRUCTIONS

  TITLE:  Set 2 Model 2- students nested in Districts; pct_sped on
          level-1 school%low ses + % black + % latine (centered; ref = white;
          random intercept + random slopes across districts.

  DATA:
    FILE IS "S:\Ibrahim\UConn Spencer Project Analysis Delaware Data\K-12_24.txt";

  VARIABLE: NAMES ARE Schl is_sped reg_num regses_num District
            blk_c lat_c wht_c
            sped_c lses_c lep_c r_seg p_sped;
            USEVARIABLES ARE
            blk_c lat_c lses_c p_sped;

           !pct_white_c is removed from the USEVARIABLES as a reference


      CLUSTER IS District;
      MISSING ARE ALL (-999); !tells MPLUS the empty cells are all NAs
      WITHIN = blk_c lat_c lses_c;


    ANALYSIS:
      TYPE = TWOLEVEL RANDOM;
      ESTIMATOR = BAYES;
      PROCESSORS = 4;
      CHAINS = 4
      BITERATIONS = 100000(20000);
      BCONVERGENCE = 0.05;

  MODEL:
      %WITHIN%

  ! Random Slopes: define latent random slope variables
      b_ses | p_sped ON lses_c;
      b_blk | p_sped ON blk_c;
      b_lat | p_sped ON lat_c;



      %BETWEEN%
      ! Allow the District random intercept and radnom slopes to covary
      p_sped b_ses b_blk b_lat;
      p_sped WITH b_ses b_blk b_lat;
      b_ses WITH b_blk b_lat;
      b_blk WITH b_lat;



    OUTPUT:
      TECH1 TECH8 STANDARDIZED;
      PLOT:
      TYPE = PLOT2






