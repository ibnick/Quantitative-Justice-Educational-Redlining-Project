INPUT INSTRUCTIONS

  TITLE:  Set 3 Model 2- students nested in Districts; pct_sped on
          level-1 school%low ses black + % lowses latine
          (centered); ref = white;
          random intercept + random slopes across districts.

  DATA:
    FILE IS "S:\Ibrahim\UConn Spencer Project Analysis Delaware Data\K-12_24.txt";

  VARIABLE: NAMES ARE Schl is_sped reg_num regses_num	District
     blk_c lat_c wht_c sped_c lses_c lep_c r_seg oss_c gen_c
     z2_c z3_c z2z3_c sehd_c dip_c p_sped lsblk_c lslat_c lswht_c;
            USEVARIABLES ARE
            lsblk_c lslat_c p_sped;

           !pct_white_c is removed from the USEVARIABLES as a reference


      CLUSTER IS District;
      MISSING ARE ALL (-999); !tells MPLUS the empty cells are all NAs
      WITHIN = lsblk_c lslat_c;


    ANALYSIS:
      TYPE = TWOLEVEL RANDOM;
      ESTIMATOR = BAYES;
      PROCESSORS = 4;
      CHAINS = 4;
      BITERATIONS = 100000(20000);
      BCONVERGENCE = 0.05;

  MODEL:
      %WITHIN%

  ! School composition (level 1) predicts random intercept
      p_sped ON lsblk_c lslat_c;


      %BETWEEN%
      ! District random intercept only
      p_sped;



    OUTPUT:
      TECH1 TECH8 STANDARDIZED;
      PLOT:
      TYPE = PLOT2;






